rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'man695223@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Domain Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 160 &&
        data.role in ['user', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivatePii(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 320 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExcelUploadRecord(data) {
      return data.keys().hasAll([
          'uploadId', 'ownerUid', 'originalFilename', 'fileExtension',
          'fileSizeBytes', 'fileSha256', 'detectedEncoding', 'totalRows',
          'sheetCount', 'chunkCount', 'localStatus', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uploadId', 'ownerUid', 'originalFilename', 'fileExtension',
          'fileSizeBytes', 'fileSha256', 'detectedEncoding', 'totalRows',
          'sheetCount', 'chunkCount', 'localStatus', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        data.uploadId is string && data.uploadId.size() >= 1 && data.uploadId.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.originalFilename is string && data.originalFilename.size() >= 1 && data.originalFilename.size() <= 200 &&
        data.fileExtension in ['.xlsx', '.xls', '.csv'] &&
        data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 210000000 &&
        data.fileSha256 is string && data.fileSha256.size() == 64 && data.fileSha256.matches('^[a-f0-9]{64}$') &&
        data.detectedEncoding is string && data.detectedEncoding.size() <= 32 &&
        data.totalRows is int && data.totalRows >= 0 && data.totalRows <= 250000 &&
        data.sheetCount is int && data.sheetCount >= 1 && data.sheetCount <= 100 &&
        data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 5000 &&
        data.localStatus is string && data.localStatus.size() >= 1 && data.localStatus.size() <= 40 &&
        data.isArchived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExcelUploadSheet(data) {
      return data.keys().hasAll([
          'uploadId', 'ownerUid', 'sheetIndex', 'sheetName',
          'rowCount', 'physicalRowCount', 'headerRowNumber', 'headers', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uploadId', 'ownerUid', 'sheetIndex', 'sheetName',
          'rowCount', 'physicalRowCount', 'headerRowNumber', 'headers', 'createdAt', 'updatedAt'
        ]) &&
        data.uploadId is string && data.uploadId.size() >= 1 && data.uploadId.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.sheetIndex is int && data.sheetIndex >= 0 && data.sheetIndex <= 100 &&
        data.sheetName is string && data.sheetName.size() >= 1 && data.sheetName.size() <= 160 &&
        data.rowCount is int && data.rowCount >= 0 && data.rowCount <= 250000 &&
        data.physicalRowCount is int && data.physicalRowCount >= 0 && data.physicalRowCount <= 250000 &&
        data.headerRowNumber is int && data.headerRowNumber >= 1 && data.headerRowNumber <= 100 &&
        data.headers is list && data.headers.size() >= 1 && data.headers.size() <= 500 &&
        data.headers[0] is string && data.headers[0].size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExcelRowChunk(data) {
      return data.keys().hasAll([
          'uploadId', 'ownerUid', 'sheetIndex', 'sheetName',
          'chunkIndex', 'rowCount', 'rows', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uploadId', 'ownerUid', 'sheetIndex', 'sheetName',
          'chunkIndex', 'rowCount', 'rows', 'createdAt'
        ]) &&
        data.uploadId is string && data.uploadId.size() >= 1 && data.uploadId.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.sheetIndex is int && data.sheetIndex >= 0 && data.sheetIndex <= 100 &&
        data.sheetName is string && data.sheetName.size() >= 1 && data.sheetName.size() <= 160 &&
        data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 5000 &&
        data.rowCount is int && data.rowCount >= 1 && data.rowCount <= 80 &&
        data.rows is list && data.rows.size() >= 1 && data.rows.size() <= 80 &&
        data.rows.size() == data.rowCount &&
        data.rows[0] is map &&
        data.rows[0].keys().hasAll(['rowNumber', 'cells']) &&
        data.rows[0].keys().hasOnly(['rowNumber', 'cells']) &&
        data.rows[0].rowNumber is int &&
        data.rows[0].cells is map &&
        data.createdAt is timestamp;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().role == 'user' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        existing().uid == userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
        isValidUserProfile(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(docId) && isOwner(userId) &&
          isValidUserPrivatePii(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isOwner(userId) &&
          existing().uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          isValidUserPrivatePii(incoming()) &&
          incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /uploads/{uploadId} {
      allow get: if isValidId(uploadId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(uploadId) && isSignedIn() &&
        isValidExcelUploadRecord(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().isArchived == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(uploadId) && isSignedIn() &&
        existing().ownerUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['localStatus', 'isArchived', 'chunkCount', 'updatedAt']) &&
        isValidExcelUploadRecord(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;

      match /sheets/{sheetId} {
        allow get: if isValidId(uploadId) && isValidId(sheetId) && isSignedIn() &&
          get(/databases/$(database)/documents/uploads/$(uploadId)).data.ownerUid == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(uploadId) && isValidId(sheetId) && isSignedIn() &&
          get(/databases/$(database)/documents/uploads/$(uploadId)).data.ownerUid == request.auth.uid &&
          isValidExcelUploadSheet(incoming()) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().uploadId == uploadId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(uploadId) && isValidId(sheetId) && isSignedIn() &&
          get(/databases/$(database)/documents/uploads/$(uploadId)).data.ownerUid == request.auth.uid &&
          existing().ownerUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['headers', 'rowCount', 'physicalRowCount', 'headerRowNumber', 'updatedAt']) &&
          isValidExcelUploadSheet(incoming()) &&
          incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /rowChunks/{chunkId} {
        allow get: if isValidId(uploadId) && isValidId(chunkId) && isSignedIn() &&
          get(/databases/$(database)/documents/uploads/$(uploadId)).data.ownerUid == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(uploadId) && isValidId(chunkId) && isSignedIn() &&
          get(/databases/$(database)/documents/uploads/$(uploadId)).data.ownerUid == request.auth.uid &&
          isValidExcelRowChunk(incoming()) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().uploadId == uploadId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }
  }
}
